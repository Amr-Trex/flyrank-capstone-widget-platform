APP_ENV=development

# SQLite database file
DATABASE_PATH=widget_platform.sqlite3

# Public base URL for widget script and config
PUBLIC_BASE_URL=http://localhost:8000

# CORS origins for the second-origin test page
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Submission limits
MAX_SUBMISSION_BYTES=10000

# Geo providers
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/

# Geo mode: mock, mock_a_down, mock_both_down
GEO_MODE=mock

# Side effect mode: console or fail or smtp
# currently set to console
EMAIL_MODE=console
# for GMAIL: smtp_host = smtp.gmail.com, smtp_port = 465, smtp_security = ssl, smtp_username = email_from = notification_email = gmail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=none

EMAIL_FROM=widget-platform@example.local
NOTIFICATION_EMAIL=owner@example.com

# Rate limit
RATE_LIMIT_PER_MINUTE=5